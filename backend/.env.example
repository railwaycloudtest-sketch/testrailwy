# ============================================================================
#  Streamify backend environment — copy to backend/.env and fill in.
# ============================================================================

# HTTP(S) port
PORT=5001

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/streamify

# Stream (https://getstream.io) chat/video app credentials
STEAM_API_KEY=your_stream_api_key
STEAM_API_SECRET=your_stream_api_secret

# development | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# TLS / HTTPS (see README-SECURITY.md)
#   - "always"  → force HTTPS even in development
#   - "off"     → never run TLS
#   - unset     → TLS ON in production, OFF in development (default)
#   Certs are auto-generated (node-forge CA + server cert) into .keys/,
#   or override with PEM strings:
# TLS_ENABLED=
# TLS_CERT=-----BEGIN CERTIFICATE-----
# TLS_KEY=-----BEGIN PRIVATE KEY-----
# TLS_CA=-----BEGIN CERTIFICATE-----

# ---------------------------------------------------------------------------
# Master key for at-rest field/file encryption (32-byte base64/hex).
# If unset, a strong master key is generated once into .keys/master.key —
# BACK UP backend/.keys/ or encrypted DB data (emails, uploads) cannot be
# recovered after a fresh checkout on another machine.
# ENCRYPTION_MASTER_KEY=

# Optional tuning (defaults shown)
# BCRYPT_COST=12
# CORS_ORIGIN=http://localhost:5173
# HOST=0.0.0.0
